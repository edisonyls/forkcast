generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Chef {
  id          String     @id @default(cuid())
  name        String
  bio         String
  rating      Float      @default(0)
  ratingCount Int        @default(0)
  image       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  secret      String
  email       String     @unique
  password    String
  username    String
  categories  Category[]
  events      Event[]
  menuItems   MenuItem[]

  @@map("chefs")
}

model Category {
  id        String     @id @default(cuid())
  name      String
  chefId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  chef      Chef       @relation(fields: [chefId], references: [id], onDelete: Cascade)
  menuItems MenuItem[]

  @@unique([name, chefId])
}

model MenuItem {
  id                   String                @id @default(cuid())
  name                 String
  description          String
  preparationTime      Int
  rating               Float                 @default(0)
  ratingCount          Int                   @default(0)
  images               String[]              @default([])
  chefId               String
  categoryId           String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  customizationOptions CustomizationOption[]
  eventOrderItems      EventOrderItem[]
  category             Category              @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  chef                 Chef                  @relation(fields: [chefId], references: [id], onDelete: Cascade)
  orderItems           OrderItem[]

  @@map("menu_items")
}

model CustomizationOption {
  id               String            @id @default(cuid())
  name             String
  menuItemId       String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  menuItem         MenuItem          @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  orderItemOptions OrderItemOption[]

  @@map("customization_options")
}

model Order {
  id                  String      @id @default(cuid())
  status              OrderStatus @default(PENDING)
  specialInstructions String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  customerName        String
  orderItems          OrderItem[]

  @@map("orders")
}

model Event {
  id          String       @id @default(cuid())
  title       String
  description String?
  eventDate   DateTime
  status      EventStatus  @default(OPEN)
  maxOrders   Int?
  chefId      String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  eventOrders EventOrder[]
  chef        Chef         @relation(fields: [chefId], references: [id], onDelete: Cascade)

  @@map("events")
}

model EventOrder {
  id              String           @id @default(cuid())
  customerName    String
  customerEmail   String?
  customerPhone   String?
  specialRequests String?
  status          EventOrderStatus @default(PENDING)
  eventId         String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  eventOrderItems EventOrderItem[]
  event           Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_orders")
}

model EventOrderItem {
  id           String     @id @default(cuid())
  quantity     Int
  specialNotes String?
  eventOrderId String
  menuItemId   String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  eventOrder   EventOrder @relation(fields: [eventOrderId], references: [id], onDelete: Cascade)
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@map("event_order_items")
}

model OrderItem {
  id         String            @id @default(cuid())
  quantity   Int
  orderId    String
  menuItemId String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  options    OrderItemOption[]
  menuItem   MenuItem          @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  order      Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model OrderItemOption {
  id                    String              @id @default(cuid())
  orderItemId           String
  customizationOptionId String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  customizationOption   CustomizationOption @relation(fields: [customizationOptionId], references: [id], onDelete: Cascade)
  orderItem             OrderItem           @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@map("order_item_options")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum EventStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum EventOrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}
