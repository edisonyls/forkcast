generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Chef {
  id          String  @id @default(cuid())
  email       String  @unique
  password    String  
  username    String
  name        String
  bio         String
  rating      Float   @default(0)
  ratingCount Int     @default(0)
  image       String?
  secret      String  // Secret string for accessing chef's menu (required)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  menuItems MenuItem[]
  categories Category[]
  events Event[]

  @@map("chefs")
}

model Category {
  id   String @id @default(cuid())
  name String
  chefId String
  chef Chef @relation(fields: [chefId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  menuItems MenuItem[]
  @@unique([name, chefId])
}

model MenuItem {
  id              String  @id @default(cuid())
  name            String
  description     String
  preparationTime Int // in minutes
  rating          Float   @default(0)
  ratingCount     Int     @default(0)
  image           String?

  chefId     String
  categoryId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  chef                  Chef                   @relation(fields: [chefId], references: [id], onDelete: Cascade)
  category              Category               @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  customizationOptions  CustomizationOption[]
  orderItems            OrderItem[]
  eventOrderItems       EventOrderItem[]

  @@map("menu_items")
}

model CustomizationOption {
  id     String @id @default(cuid())
  name   String

  menuItemId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  menuItem           MenuItem             @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  orderItemOptions   OrderItemOption[]

  @@map("customization_options")
}

model Order {
  id            String      @id @default(cuid())
  customerName  String
  status        OrderStatus @default(PENDING)
  specialInstructions String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  orderItems OrderItem[]

  @@map("orders")
}

model Event {
  id          String      @id @default(cuid())
  title       String
  description String?
  eventDate   DateTime
  status      EventStatus @default(OPEN)
  maxOrders   Int?        // Optional limit on number of orders
  
  chefId      String
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  // Relations
  chef        Chef        @relation(fields: [chefId], references: [id], onDelete: Cascade)
  eventOrders EventOrder[]
  
  @@map("events")
}

model EventOrder {
  id               String    @id @default(cuid())
  customerName     String
  customerEmail    String?
  customerPhone    String?
  specialRequests  String?
  status           EventOrderStatus @default(PENDING)
  
  eventId          String
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  // Relations
  event            Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventOrderItems  EventOrderItem[]
  
  @@map("event_orders")
}

model EventOrderItem {
  id              String    @id @default(cuid())
  quantity        Int
  specialNotes    String?
  
  eventOrderId    String
  menuItemId      String
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  eventOrder      EventOrder  @relation(fields: [eventOrderId], references: [id], onDelete: Cascade)
  menuItem        MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  
  @@map("event_order_items")
}

model OrderItem {
  id       String @id @default(cuid())
  quantity Int

  orderId    String
  menuItemId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  order    Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem              @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  options  OrderItemOption[]

  @@map("order_items")
}

model OrderItemOption {
  id    String @id @default(cuid())

  orderItemId           String
  customizationOptionId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  orderItem           OrderItem           @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  customizationOption CustomizationOption @relation(fields: [customizationOptionId], references: [id], onDelete: Cascade)

  @@map("order_item_options")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum EventStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum EventOrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
} 