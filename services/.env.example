# Optional local Docker Compose overrides.
# Copy this file to .env and change only the values you need.

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/forkcast
REDIS_URL=redis://redis:6379

JWT_SECRET=replace-with-a-local-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Use ./uploads for local storage or an absolute host-mounted NFS path.
UPLOADS_PATH=./uploads
