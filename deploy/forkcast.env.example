# Install the real file at /etc/forkcast/forkcast.env with mode 0600.
TAILSCALE_IP=100.124.227.110

POSTGRES_DB=forkcast
POSTGRES_USER=forkcast
POSTGRES_PASSWORD=replace-with-a-random-hex-secret
DATABASE_URL=postgresql://forkcast:replace-with-the-same-random-hex-secret@postgres:5432/forkcast?schema=public

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d

